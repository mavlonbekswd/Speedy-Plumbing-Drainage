# Copy to .env.local for local dev, and set the same keys in
# Vercel → Settings → Environment Variables (Production AND Preview).
# VITE_ / NEXT_PUBLIC_ values are baked into the browser bundle at BUILD time:
# change one in Vercel → redeploy. They are public identifiers, not secrets.

# ─── Google tag (optional — unset just disables analytics) ─────────────────
# Without these the build still succeeds and the site works; the gtag snippet
# is simply left out rather than shipped pointing at a non-existent id.
# Google Ads account tag id: Google Ads → Goals → Google tag. Format AW-<digits>.
VITE_GADS_ID=
# GA4 measurement id: GA4 → Admin → Data streams → Web. Format G-XXXXXXXXXX.
VITE_GA4_ID=

# ─── Google Ads conversion labels (optional until the actions exist) ────────
# The part AFTER the slash in "AW-xxxx/LABEL" on each conversion action's
# "Use Google tag" snippet. While empty, that conversion is skipped (console
# warning) — everything else keeps working.
# Google Ads action "Lead form book" (fires when a quote reaches Telegram).
VITE_GADS_LABEL_QUOTE=
# Google Ads action "Website phone call" (fires on a tel: link tap).
VITE_GADS_LABEL_PHONE=

# ─── PostHog ────────────────────────────────────────────────────────────────
# Project token (phc_...) and ingestion host from PostHog → Project settings.
# Events go through the same-origin /ingest proxy (vercel.json / vite proxy).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Quote delivery (server-only — never prefix with VITE_/NEXT_PUBLIC_) ────
# There is no database: the Telegram group message IS the lead record. If
# these are unset, /api/quote returns 500 and the form shows "call us".
# Bot token: create a bot with @BotFather and copy its token.
TELEGRAM_BOT_TOKEN=
# Group chat id: add the bot to the group, then read the id (negative number)
# from https://api.telegram.org/bot<TOKEN>/getUpdates after posting a message.
TELEGRAM_CHAT_ID=
# Optional: people to @mention on EMERGENCY requests, e.g. "@dave @sam".
TELEGRAM_ADMIN_MENTIONS=
