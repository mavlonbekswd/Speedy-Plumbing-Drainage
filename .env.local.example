# Copy to .env.local and fill in. Never commit real values.

# Canonical origin of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL=
# The public phone number, UK national format.
NEXT_PUBLIC_CALL_NUMBER=

# Telegram bot that receives booking notifications.
TELEGRAM_BOT_TOKEN=
# Chat the bot posts bookings into.
TELEGRAM_CHAT_ID=
# Comma separated @handles to mention on an out of hours booking.
TELEGRAM_ADMIN_MENTIONS=
# Set to force the out of hours escalation path on, regardless of the clock.
OOH_ALERT_FORCE=
# Override the Telegram API base URL (tests only).
TELEGRAM_API_BASE=
# Override the booking rate limit ceiling (tests only).
BOOK_RATE_LIMIT_MAX=

# PostHog project API key (legacy name accepted: NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN).
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingestion host, normally the site's own /ingest proxy path.
NEXT_PUBLIC_POSTHOG_HOST=

# Google Ads conversion account id (legacy: VITE_GADS_ID).
NEXT_PUBLIC_GADS_ID=
# Conversion label for a completed booking (legacy: VITE_GADS_LABEL_QUOTE).
NEXT_PUBLIC_GADS_LABEL_BOOKING=
# Conversion label for a tap on a phone link (legacy: VITE_GADS_LABEL_PHONE).
NEXT_PUBLIC_GADS_LABEL_PHONE_TAP=
# Conversion label for a connected phone call.
NEXT_PUBLIC_GADS_LABEL_PHONE_CALL=
# Conversion label for a WhatsApp click.
NEXT_PUBLIC_GADS_LABEL_WHATSAPP=
# Google Analytics 4 measurement id (legacy: VITE_GA4_ID).
NEXT_PUBLIC_GA4_ID=
